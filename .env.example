# -------------------------------------------------------
# KBA Core — environment variable template
# Copy to .env and fill in real values before running.
# -------------------------------------------------------

FLASK_ENV=development
SECRET_KEY=replace-with-random-string
DEBUG=true

# PostgreSQL
DATABASE_URL=postgresql://kba_user:kba_pass@localhost:5432/kba_db

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=replace-with-another-random-string
JWT_ACCESS_EXPIRES_MINUTES=60
JWT_REFRESH_EXPIRES_DAYS=30

# Certificates
CERT_STORAGE_PATH=/tmp/kba_certs
QR_BASE_VERIFY_URL=http://localhost:5000/verify

# RSA Keys
RSA_KEY_SIZE=2048
RSA_KEY_STORAGE_PATH=/tmp/kba_keys

# Workers / RQ
RQ_QUEUE_NAME=kba_jobs
RQ_MAX_RETRIES=3
DEAD_LETTER_QUEUE_NAME=kba_dead_letter
